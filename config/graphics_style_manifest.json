{
  "manifest_version": "1.0",
  "default_profile": "retro_modern_v1",
  "openai": {
    "model": "gpt-image-1",
    "size": "1024x1024",
    "background": "transparent",
    "max_retries": 2
  },
  "profiles": {
    "retro_modern_v1": {
      "style_anchor": "Baseball retro-modern visual direction with high readability, crisp vector-influenced forms, and restrained texture.",
      "negative_constraints": [
        "No photorealistic rendering",
        "No heavy text overlays",
        "No crowded scenic backgrounds",
        "No neon/purple dominant palettes",
        "No text, letters, numbers, words, or labels",
        "No fake window chrome, close icons, or literal form controls",
        "No bloom haze, fog, or glowing halos around the composition"
      ],
      "palette_tokens": [
        "#0A3161",
        "#C8102E",
        "#F6F4EF",
        "#1F2937",
        "#F59E0B"
      ],
      "shape_language": [
        "bold badge silhouettes",
        "clean geometric panels",
        "angled action motifs"
      ],
      "lighting_rules": [
        "high-contrast but controlled highlights",
        "minimal bloom and no haze",
        "avoid crushed shadows"
      ]
    }
  },
  "validation": {
    "logo": {
      "width": 1024,
      "height": 1024,
      "require_alpha": true,
      "min_transparent_ratio": 0.15,
      "palette_delta_max": 150.0,
      "phash_max_distance": 40,
      "edge_density_min": 0.01,
      "edge_density_max": 0.45
    },
    "ui": {
      "width": 1024,
      "height": 1024,
      "require_alpha": true,
      "min_transparent_ratio": 0.05,
      "palette_delta_max": 155.0,
      "phash_max_distance": 44,
      "edge_density_min": 0.06,
      "edge_density_max": 0.42
    }
  },
  "golden_set": [
    {
      "id": "logo_reference_v1",
      "category": "logo",
      "path": "assets/graphics/golden/logo_reference_v1.png",
      "profile": "retro_modern_v1"
    },
    {
      "id": "ui_reference_v1",
      "category": "ui",
      "path": "assets/graphics/golden/ui_reference_v1.png",
      "profile": "retro_modern_v1"
    }
  ]
}
