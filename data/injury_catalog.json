{
  "metadata": {
    "name": "NexGen Standard Injury Catalog",
    "version": 1,
    "source": "data/injury_catalog.json",
    "description": "Baseline injury catalog seeded into every new league. Trigger probabilities, modifiers and severity lists are kept identical to the engine's built-in fallback so injury FREQUENCY and SEVERITY mix are unchanged (calibration-neutral); this catalog only widens the VARIETY of injuries (body parts, names, and rating penalties) that can result from each trigger/severity. Triggers 'throwing', 'swing' and 'fielding' are fired by the engines but intentionally left out here — adding them would create injuries where there currently are none, which needs a KPI/calibration pass."
  },
  "triggers": {
    "collision": {
      "base_probability": 0.12,
      "modifiers": { "durability_factor": -0.35 },
      "severities": ["minor", "moderate"]
    },
    "hit_by_pitch": {
      "base_probability": 0.08,
      "modifiers": { "durability_factor": -0.25 },
      "severities": ["minor"]
    },
    "pitcher_overuse": {
      "base_probability": 0.18,
      "modifiers": { "fatigue_factor": 0.45 },
      "severities": ["moderate", "major"]
    }
  },
