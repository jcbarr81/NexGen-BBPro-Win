{
  "hosting": {
    "site": "nexgen-bbpro",
    "public": "desktop/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "postdeploy": "python scripts/videos_site.py --keep",
    "rewrites": [
      { "source": "/discover", "destination": "/index.html" },
      { "source": "/register", "destination": "/index.html" },
      { "source": "/my-leagues", "destination": "/index.html" },
      { "source": "/home", "destination": "/index.html" },
      {
        "source": "**",
        "run": {
          "serviceId": "nexgen-bbpro-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
