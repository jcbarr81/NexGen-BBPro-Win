# Cloud mode: run the web UI in a browser against the Cloud Run backend.
# Loaded only when Vite runs with `--mode cloud` (npm run dev:cloud), so it
# never interferes with the normal Electron + local-sidecar dev flow
# (.env.development).
#
# Log in with a real league account (e.g. jcbarr) — the session token from
# /auth/login is what authorizes every request; no launch token needed.
VITE_API_BASE_URL=https://nexgen-bbpro-api-qkqdnsoglq-uc.a.run.app
VITE_WS_BASE_URL=wss://nexgen-bbpro-api-qkqdnsoglq-uc.a.run.app
VITE_LAUNCH_TOKEN=
