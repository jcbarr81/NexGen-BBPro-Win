# Controls what `gcloud run deploy --source` uploads to Cloud Build.
# Mirrors .dockerignore so the 60k-file .venv2/ and other heavy paths
# are NOT uploaded. (gcloud does NOT consult .dockerignore for the upload.)

.venv2/
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Frontend source IS needed (multi-stage Docker build compiles it); exclude
# only the heavy/generated parts.
desktop/node_modules/
desktop/dist/
desktop/dist-electron/
desktop/release/
node_modules/

# Leading slash = repo-root only, so these don't also strip desktop/src/assets,
# desktop images, etc. (the UI build needs those).
/data/
/tmp/
# Keep docs/ (the in-app Help manual reads docs/manuals/*.md/html at runtime);
# only drop the heavy notes/ image dump.
/docs/notes/
/tests/
/samples/
# Keep the avatar recolor templates + default.png (the cloud avatar generator
# needs them at runtime); drop only the ~600 generated player avatars (~880MB)
# and parks. MUST match .dockerignore — this is the UPLOAD filter, so anything
# excluded here never reaches Cloud Build at all.
/images/avatars/P*.png
/images/parks/
/images/buttons/
/images/__pycache__/
/assets/
# Root build artifacts (PyInstaller output, reports) — never needed at runtime.
/dist/
/build/
/reports/
/logo/
/release/

bcrypt.py
_tmp_*.py
_slice*.txt
_tmp_*.txt
build_exe.py
data_snapshot.tgz

.git/
.github/
.githooks/
.claude/
*.log
